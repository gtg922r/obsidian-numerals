{
	"name": "obsidian-numerals",
	"version": "1.11.0",
	"description": "Numerals turns any code block into an advanced calculator. Evaluates math expressions on each line of a code block, including units, currency, and optional TeX rendering.",
	"main": "main.js",
	"scripts": {
		"dev": "node scripts/esbuild.config.mjs",
		"test": "jest",
		"lint": "eslint src/",
		"build": "npm run release:check && npm run typecheck && node scripts/esbuild.config.mjs production",
		"symbols:check": "node scripts/run-ts-script.mjs scripts/mathjs-symbols.ts check",
		"symbols:update": "node scripts/run-ts-script.mjs scripts/mathjs-symbols.ts update",
		"release": "node scripts/release-production.mjs",
		"release:beta": "node scripts/release-beta.mjs",
		"release:production": "node scripts/release-production.mjs",
		"version:patch": "node scripts/version-increment.mjs patch",
		"version:minor": "node scripts/version-increment.mjs minor",
		"version:major": "node scripts/version-increment.mjs major",
		"typecheck": "tsc --project tsconfig.json",
		"typecheck:tests": "tsc --project tsconfig.test.json",
		"typecheck:scripts": "tsc --project tsconfig.scripts.json",
		"test:toolchain": "node --test tests/toolchain/*.test.mjs",
		"build:reproducible": "node scripts/check-reproducible-build.mjs",
		"release:check": "node scripts/check-release.mjs",
		"check": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts && npm test -- --runInBand && npm run test:toolchain && npm run build && npm run symbols:check && npm run build:reproducible && npm run release:check",
		"version:bump": "node scripts/version-increment.mjs"
	},
	"keywords": [],
	"author": "RyanC",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "6.12.3",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.2",
		"@eslint/json": "^0.14.0",
		"@types/jest": "^29.5.2",
		"@types/node": "^22.19.11",
		"@typescript-eslint/eslint-plugin": "^8.56.0",
		"@typescript-eslint/parser": "^8.56.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "0.4.2",
		"jest": "^29.5.0",
		"jest-environment-jsdom": "^29.7.0",
		"js-yaml": "4.3.2",
		"obsidian": "1.13.1",
		"ts-jest": "^29.1.0",
		"tslib": "2.8.1",
		"typescript": "~5.8",
		"typescript-eslint": "^8.56.0"
	},
	"dependencies": {
		"fast-deep-equal": "3.1.3",
		"mathjs": "15.2.0"
	},
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11 <12"
	}
}
